{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup":   { "nixPkgs": ["nodejs_20", "pnpm-9_x"] },
        "install": { "cmds": ["cd ../.. && pnpm install --frozen-lockfile"] },
        "build":   { "cmds": ["cd ../.. && pnpm --filter @panel/db build && pnpm --filter @panel/api build"] }
      }
    }
  },
  "deploy": {
    "startCommand": "node dist/migrate.js && node dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

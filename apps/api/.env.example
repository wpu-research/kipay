# Database
DATABASE_URL=postgresql://user:password@localhost:5432/panel_dev

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_TEMP_SECRET=your-jwt-temp-secret-min-32-chars

# TOTP (AES-256-GCM encryption key — 64 hex chars = 32 bytes)
TOTP_ENCRYPTION_KEY=<openssl rand -hex 32 ile üret — 64 hex karakter = 32 byte AES-256-GCM anahtarı>

# Cookie signing (optional, min 32 chars)
COOKIE_SECRET=your-random-32-char-cookie-secret-here

# Proxy güven listesi (production'da gerçek proxy IP/CIDR girin, örn. 10.0.0.1)
# Development'ta bu değişkeni boş bırakabilirsiniz (trustProxy otomatik true olur)
TRUSTED_PROXY_IP=

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Frontend (Next.js default: 3000)
FRONTEND_URL=http://localhost:3000
